{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verbix",
  "version": "0.1.0",
  "identifier": "com.verbix.app",
  "build": {
    "frontendDist": "panel"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/voice": "voice",
      "resources/licenses": "licenses"
    }
  }
}
